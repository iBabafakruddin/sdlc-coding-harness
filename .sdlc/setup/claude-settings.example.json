{
  "permissions": {
    "allow": [
      "Bash(python .sdlc/tools/board.py:*)",
      "Bash(python .sdlc/tools/git_flow.py:*)",
      "Bash(python .sdlc/tools/quality_gate.py:*)",
      "Bash(git worktree list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.sdlc/tools/board.py\" render --quiet",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
